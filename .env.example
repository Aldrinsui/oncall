# ==============================================================================
# OnGround.ai — Telephony & Backend Environment Configuration
# ==============================================================================

# Telephony Provider Selection: 'twilio', 'plivo', or 'mock'
TELEPHONY_PROVIDER=twilio

# Public Webhook Base URL (use ngrok / tunnel for local testing, e.g. https://abc123.ngrok-free.app)
PUBLIC_WEBHOOK_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Twilio PSTN Credentials (Recommended for immediate testing)
# ------------------------------------------------------------------------------
# Retrieve from Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_CALLER_ID=+1234567890

# ------------------------------------------------------------------------------
# Plivo PSTN Credentials (Requires India-registered entity & approved KYC for +91)
# ------------------------------------------------------------------------------
# Retrieve from Plivo Console: https://console.plivo.com/
PLIVO_AUTH_ID=MAMXXXXXXXXXXXXXXXXX
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_CALLER_ID=+918000000000

# ------------------------------------------------------------------------------
# Application & Database Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Leave blank for default local SQLite (sqlite+aiosqlite:///./oncall.db)
# Or provide PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/onground
DATABASE_URL=sqlite+aiosqlite:///./oncall.db

# Development Identity Bypass
DEV_AUTH_BYPASS_ENABLED=true
DEV_AGENT_ID=00000000-0000-0000-0000-000000000001
DEV_AGENT_PHONE=+919000000001
